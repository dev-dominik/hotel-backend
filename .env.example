NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

SESSION_NAME=hotel-session
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars-long
SESSION_HTTP_ONLY=false
SESSION_MAX_AGE=86400000
SESSION_SAME_SITE=lax
SESSION_SECURE=false

MAIL_RESEND_DISABLED=true
RESEND_API_KEY=
MAIL_FROM= #delivered@resend.dev for dev

GOOGLE_DISABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_DISABLED=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

HCAPTCHA_SECRET=your-recaptcha-secret-key

CLOUDINARY_CLOUD_NAME=twoj_cloud_name
CLOUDINARY_API_KEY=twoj_api_key
CLOUDINARY_API_SECRET=twoj_api_secret

MEDIA_STORAGE=local                          # or "cloudinary" (default)
MEDIA_LOCAL_UPLOAD_DIR=./uploads             # where files are saved on disk
MEDIA_LOCAL_BASE_URL=http://localhost:3000

# docker-compose overrides (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hotel



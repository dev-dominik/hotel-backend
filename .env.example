NODE_ENV=development
PORT=3000
DOMAIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hotel
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

REDIS_URL=redis://localhost:6379

SESSION_NAME=hotel-session
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars-long
SESSION_HTTP_ONLY=false
SESSION_MAX_AGE=86400000
SESSION_SAME_SITE=lax
SESSION_SECURE=false

GOOGLE_DISABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_DISABLED=true
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

HCAPTCHA_SECRET=your-recaptcha-secret-key

# docker-compose overrides (optional)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hotel
